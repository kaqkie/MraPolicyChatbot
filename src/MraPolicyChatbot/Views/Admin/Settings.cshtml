@model MraPolicyChatbot.Models.AdminSettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="admin-page">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">Settings</h1>
            <div class="muted">Configure assistant behaviour and appearance</div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-3">Assistant</h2>
                    <form asp-controller="Admin" asp-action="SaveGeneralSettings" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <div class="fw-600">Voice responses</div>
                                <div class="muted small">Read answers aloud when available</div>
                            </div>
                            <div>
                                <input type="checkbox" id="voiceToggle" name="VoiceResponses" class="form-check-input" />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <div class="fw-600">Show source citations</div>
                                <div class="muted small">Include policy references in answers</div>
                            </div>
                            <div>
                                <input type="checkbox" id="citationToggle" name="ShowCitations" class="form-check-input" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Chunk size</label>
                            <select name="ChunkSize" class="form-select" style="max-width:200px">
                                <option value="500">500</option>
                                <option value="1000">1000</option>
                                <option value="1500">1500</option>
                            </select>
                        </div>

                        <button class="btn btn-primary">Save Assistant settings</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-3">Appearance</h2>
                    <form asp-controller="Admin" asp-action="SaveAppearanceSettings" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Theme</label>
                            <select name="Theme" class="form-select" style="max-width:220px">
                                <option value="system">System</option>
                                <option value="light">Light</option>
                                <option value="dark">Dark</option>
                            </select>
                            <div class="form-text">Controls the admin UI appearance.</div>
                        </div>
                        <button class="btn btn-primary">Save Appearance</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
