@model List<MraPolicyChatbot.Models.PolicyListItemViewModel>?
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Policy management";

    // Sample data fallback when Model is null or empty
    var sample = new[] {
        new {Title = "Code of Conduct and Ethics", Dept = "Internal Affairs", Status = "Failed", Chunks = 0},
        new {Title = "Disciplinary and Grievance Procedure", Dept = "Human Resource and Organisation Development", Status = "Processed", Chunks = 2},
        new {Title = "ICT Acceptable Use Policy", Dept = "Information & Communication Technology (ICT)", Status = "Processed", Chunks = 2},
        new {Title = "Staff Leave and Absence Policy", Dept = "Human Resource and Organisation Development", Status = "Processed", Chunks = 2},
        new {Title = "Travel and Subsistence Policy", Dept = "Finance", Status = "Processed", Chunks = 2},
        new {Title = "Working Hours and Attendance Policy", Dept = "Human Resource and Organisation Development", Status = "Processed", Chunks = 2},
    };
}

<div class="admin-page">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">Policy management</h1>
            <div class="muted">Manage the documents used by the Q&amp;A assistant</div>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="UploadPolicy" class="btn btn-primary">+ Upload policy</a>
        </div>
    </div>

    <div class="stats-row mb-3">
        <div class="stat-card">
            <div class="label">Total policies</div>
            <div class="value">6</div>
        </div>
        <div class="stat-card">
            <div class="label">Processed</div>
            <div class="value">5</div>
        </div>
        <div class="stat-card">
            <div class="label">Failed</div>
            <div class="value text-danger">1</div>
        </div>
        <div class="stat-card">
            <div class="label">Total chunks</div>
            <div class="value">10</div>
        </div>
    </div>

    <div id="failureBanner" class="alert alert-danger d-flex justify-content-between align-items-center mb-3" role="alert" style="display:block">
        <div>Code of Conduct and Ethics failed to process and can't be searched yet</div>
        <div>
            <form asp-controller="Admin" asp-action="ReprocessPolicy" method="post" class="d-inline">
                <input type="hidden" name="id" value="1" />
                <button type="submit" class="btn btn-outline-light btn-sm text-danger">Retry now</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-toolbar d-flex gap-2 mb-3">
                <input id="policySearch" class="form-control form-control-sm" placeholder="Search policies..." />
                <select id="statusFilter" class="form-select form-select-sm" style="width:210px">
                    <option value="">All statuses</option>
                    <option value="Processed">Processed</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>

            <div class="table-responsive">
                <table id="policiesTable" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Policy</th>
                            <th>Department</th>
                            <th>Uploaded</th>
                            <th>Status</th>
                            <th>Chunks</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in (Model != null && Model.Count > 0 ? Model.Select(m => new {Title=m.Title, Dept=m.Category, Uploaded = m.UploadDate.ToString("dd MMM yyyy"), Status = m.IsProcessed ? "Processed" : (string.IsNullOrEmpty(m.ProcessingError)? "Processing" : "Failed"), Chunks = m.ChunkCount}) : sample))
                        {
                            <tr data-status="@row.Status">
                                <td><strong>@row.Title</strong></td>
                                <td class="muted">@row.Dept</td>
                                <td class="muted">15 Sep 2026</td>
                                <td>
                                    @if (row.Status == "Processed")
                                    {
                                        <span class="badge bg-success text-white small">Processed</span>
                                    }
                                    else if (row.Status == "Failed")
                                    {
                                        <span class="badge bg-danger text-white small">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white small">Processing</span>
                                    }
                                </td>
                                <td>@row.Chunks</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a class="btn btn-outline-secondary btn-sm">View</a>
                                        <a class="btn btn-outline-secondary btn-sm">Edit</a>
                                        <button class="btn btn-outline-secondary btn-sm">Retry</button>
                                        <button class="btn btn-outline-danger btn-sm">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="emptyState" class="text-center muted py-4" style="display:none">No policies match</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
