@model List<MraPolicyChatbot.Models.PolicyListItemViewModel>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row">
    <aside class="col-12 col-md-3 mb-3">
        <partial name="_AdminSidebar" />
    </aside>

    <section class="col-12 col-md-9">
        @* The "Upload New Policy" button that used to live here was
           removed at the project owner's request — use the "Upload
           Policy" link in the sidebar instead; the page/action itself is
           unchanged. *@
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h1 class="h3 mb-0">Policy Management</h1>
        </div>

        <div class="mb-3">
            <a asp-controller="Admin" asp-action="Settings" asp-fragment="departments" class="small">Manage departments</a>
        </div>

        @if (TempData["PolicySuccessMessage"] is not null)
        {
            <div class="alert alert-success py-2" role="alert">@TempData["PolicySuccessMessage"]</div>
        }
        @if (TempData["PolicyErrorMessage"] is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@TempData["PolicyErrorMessage"]</div>
        }

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Upload Date</th>
                            <th>Status</th>
                            <th>Chunks</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model!.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No policies uploaded yet. Use "Upload Policy" in the sidebar to add one.
                                </td>
                            </tr>
                        }
                        @foreach (var policy in Model!)
                        {
                            <tr>
                                <td>@policy.Title</td>
                                <td>@policy.Category</td>
                                <td>@policy.UploadDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (policy.IsProcessed)
                                    {
                                        <span class="text-success" title="Processed successfully">&#10003; Processed</span>
                                    }
                                    else if (!string.IsNullOrEmpty(policy.ProcessingError))
                                    {
                                        <span class="text-danger" title="@policy.ProcessingError">&#10007; Failed</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning" title="Extraction and chunking in progress">&#8987; Processing...</span>
                                    }
                                </td>
                                <td>@policy.ChunkCount chunks</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        @if (policy.HasFile)
                                        {
                                            <a asp-controller="Admin" asp-action="ViewFile" asp-route-id="@policy.Id" class="btn btn-outline-secondary btn-sm">View file</a>
                                        }
                                        <a asp-controller="Admin" asp-action="EditPolicy" asp-route-id="@policy.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                        <form asp-controller="Admin" asp-action="ReprocessPolicy" asp-route-id="@policy.Id" method="post" class="mb-0">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                    title="Re-extracts text and rebuilds search embeddings from the currently stored file, without needing to re-upload it. Use this if processing failed, or if the chatbot doesn't seem to find this policy in its answers.">
                                                Retry processing
                                            </button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="DeletePolicy" asp-route-id="@policy.Id" method="post" class="mb-0"
                                              onsubmit="return confirm('Delete this policy and its search data? This can\'t be undone.');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    title="Permanently removes this policy, its stored file (if any), and its search data. Use this for an entry that will never process successfully — e.g. its file was lost and there's no copy to re-upload.">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
