@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Departments";
}

<div class="admin-page">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">Departments</h1>
            <div class="muted">Manage the list of departments used to categorise policies</div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="AddDepartment" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input name="name" id="newDept" class="form-control" placeholder="Add department" />
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ul id="departmentsList" class="list-group">
                @{
                    var depts = ViewBag.Departments as List<string> ?? new List<string>();
                    var counts = ViewBag.DepartmentCounts as Dictionary<string,int> ?? new Dictionary<string,int>(StringComparer.OrdinalIgnoreCase);
                }
                @foreach (var d in depts)
                {
                    var c = counts.ContainsKey(d) ? counts[d] : 0;
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-600">@d</div>
                            <div class="muted small">@c policies</div>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-controller="Admin" asp-action="RenameDepartment" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="oldName" value="@d" />
                                <input name="newName" placeholder="New name" class="form-control form-control-sm d-inline" style="width:160px; display:inline-block" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Rename</button>
                            </form>
                            <form asp-controller="Admin" asp-action="DeleteDepartment" method="post" onsubmit="return confirm('Delete this department? Policies in this category will keep their category value.')" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="name" value="@d" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
