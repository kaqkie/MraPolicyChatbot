@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Upload Policy";
}

<div class="admin-page">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">Upload policy</h1>
            <div class="muted">Add a new document for the assistant to index</div>
        </div>
    </div>

    <div class="card" style="max-width:640px">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="UploadPolicy" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input name="title" class="form-control" placeholder="e.g. Remote Work Policy" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Department</label>
                    <select name="category" class="form-select">
                        @if (ViewBag.Departments is IEnumerable<string> depts)
                        {
                            foreach (var d in depts)
                            {
                                <option value="@d">@d</option>
                            }
                        }
                    </select>
                    <div class="form-text">Don't see it? <a asp-controller="Admin" asp-action="Settings" asp-fragment="departments">Manage departments</a></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Policy file</label>
                    <div id="fileDrop" class="file-drop" tabindex="0">
                        <div class="file-drop-inner">
                            <div class="muted">Drop a file here or click to browse</div>
                            <div class="muted small">PDF or DOCX · up to 20 MB</div>
                            <input type="file" name="file" id="policyFileInput" class="d-none" />
                            <div id="chosenFile" class="chosen-file muted" aria-live="polite"></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Upload</button>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
