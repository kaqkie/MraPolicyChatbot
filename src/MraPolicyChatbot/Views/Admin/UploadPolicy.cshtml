@{
    ViewData["Title"] = "Upload Policy";
}

<div class="row">
    <aside class="col-12 col-md-3 mb-3">
        <partial name="_AdminSidebar" />
    </aside>

    <section class="col-12 col-md-9">
        <h1 class="h3 mb-3">Upload New Policy</h1>

        @if (ViewBag.ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="card">
            <div class="card-body">
                <form asp-controller="Admin" asp-action="UploadPolicy" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Remote Work Policy" required />
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Department</label>
                        <select class="form-select" id="category" name="category" required>
                            <option value="" selected disabled>Select a department...</option>
                            @foreach (var department in (IEnumerable<string>)ViewBag.Departments)
                            {
                                <option value="@department">@department</option>
                            }
                        </select>
                        <div class="form-text">
                            Don't see the right department? <a asp-controller="Admin" asp-action="Settings" asp-fragment="departments">Manage departments</a>.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="file" class="form-label">Policy File</label>
                        <input type="file" class="form-control" id="file" name="file" accept=".pdf,.docx" required />
                        <div class="form-text">PDF or DOCX only, up to 20 MB.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Upload</button>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
