<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Policy Desk</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar app-nav">
            <div class="container app-nav-inner">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 3.5h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1z" />
                            <path d="M14 3.5v4h4" />
                            <path d="M9 12.5h6" />
                            <path d="M9 16h6" />
                        </svg>
                    </span>
                    <span class="brand-name"><strong>Policy</strong> Desk</span>
                </a>
                @if (Context.Session.IsLoggedIn())
                {
                    var username = Context.Session.GetUsername() ?? "";
                    var role = Context.Session.GetRole() ?? "";
                    var avatarUrl = Context.Session.GetAvatarUrl();
                    <div class="d-flex align-items-center gap-3 position-relative">
                        <button id="profileButton" class="profile-btn" aria-haspopup="true" aria-expanded="false" aria-controls="profileDropdown">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Profile" class="profile-avatar" />
                            }
                            else
                            {
                                <span class="profile-initials">@(!string.IsNullOrEmpty(username) ? username.Substring(0,1).ToUpper() : "?")</span>
                            }
                        </button>

                        <div id="profileDropdown" class="profile-dropdown" role="menu" aria-labelledby="profileButton" hidden>
                            <div class="profile-panel">
                                <div class="profile-panel-head">
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="Profile" class="profile-avatar-lg" />
                                    }
                                    else
                                    {
                                        <div class="profile-avatar-lg profile-initials-lg">@(!string.IsNullOrEmpty(username) ? username.Substring(0,1).ToUpper() : "?")</div>
                                    }
                                    <div class="profile-meta">
                                        <div class="profile-name">@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(username)))</div>
                                        <div class="profile-email">@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(username))</div>
                                        <div class="profile-role">@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(role))</div>
                                    </div>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0 mt-2">
                                    <button type="submit" class="btn btn-quiet btn-block">Log out</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-ink btn-sm">Log in <span aria-hidden="true">&#8599;</span></a>
                }
            </div>
        </nav>
    </header>
    <div class="container app-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container d-flex justify-content-between">
            <span>Internal Use Only</span>
            <span>Policy desk / 2026</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/header.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
