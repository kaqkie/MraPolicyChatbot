@{
    ViewData["Title"] = "Internal Policy Chatbot";
}

<div class="home-hero">
    <div class="hero-kicker"><span></span> Internal policy intelligence</div>
    <div class="row align-items-end g-5">
        <div class="col-lg-8">
            <h1>Clarity, from<br /><em>the source.</em></h1>
            <p class="hero-copy">Ask questions about approved policy documents and get answers grounded in the official text.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg mt-3">Enter the policy desk <span aria-hidden="true">&#8599;</span></a>
        </div>
        <div class="col-lg-4">
            <div class="hero-note">
                <span class="note-number">01</span>
                <p>Built for staff who need a clear answer, not a search expedition.</p>
                <div class="note-rule"></div>
                <span class="note-caption">Approved documents only</span>
            </div>
        </div>
    </div>
</div>
